# ---------------------------------------------------------------------------
# Forge / IndieVST - example environment file
#
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
#
# The plugin reads configuration in this order (first hit wins):
#   1. %APPDATA%\Forge\config.json      <- written by the plugin's Settings panel
#   2. environment variables            <- useful for the Standalone dev build
#   3. a `.env` file next to the executable or in the repo root (dev only)
#
# Loading a `.env` file is a DEVELOPMENT convenience. Shipping builds should
# rely on the Settings panel, which stores the key in the user's own AppData.
# API keys are never written into the DAW project state.
# ---------------------------------------------------------------------------

# Which provider to use: anthropic | openai | ollama | canned
FORGE_LLM_PROVIDER=anthropic

# --- Anthropic ---
FORGE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FORGE_ANTHROPIC_MODEL=claude-sonnet-5
FORGE_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI ---
FORGE_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FORGE_OPENAI_MODEL=gpt-4.1
FORGE_OPENAI_BASE_URL=https://api.openai.com

# --- Ollama (local, no key needed) ---
FORGE_OLLAMA_BASE_URL=http://localhost:11434
FORGE_OLLAMA_MODEL=llama3.1:8b

# --- Generation behaviour ---
# Hard wall-clock budget for prompt -> playable instrument, milliseconds.
FORGE_GENERATION_TIMEOUT_MS=12000
# Number of validator-feedback retries before falling back to the repairer.
FORGE_MAX_RETRIES=1
# Sampling temperature for instrument generation.
FORGE_TEMPERATURE=0.7
# Set to 1 to force the offline CannedProvider (useful for rehearsing the demo).
FORGE_FORCE_OFFLINE=0

# --- Engine ---
FORGE_POLYPHONY=16
# Estimated fraction of one core the CPU budget check allows (0.0 - 1.0).
FORGE_CPU_BUDGET=0.35
# Write every raw LLM response to %APPDATA%\Forge\logs for debugging.
FORGE_LOG_RAW_RESPONSES=0
